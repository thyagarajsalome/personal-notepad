---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/Layout.astro';
import Sidebar from '../components/Sidebar';
import Editor from '../components/Editor';
---

<BaseLayout>
  <Layout>
    <!-- Sidebar — React island, hydrates immediately -->
    <Sidebar client:load slot="sidebar" />

    <!-- Editor — React island, hydrates when idle -->
    <!-- Editor handles both empty state and active note display -->
    <div class="flex-1 flex flex-col h-full">
      <Editor client:idle />
    </div>
  </Layout>
</BaseLayout>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    html, body {
      @apply h-full;
    }
    body {
      @apply bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-200;
    }
  }
</style>
